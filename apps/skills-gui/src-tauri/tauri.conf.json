{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills GUI",
  "version": "0.1.0",
  "identifier": "com.ogutierrez.dotfiles.skills-gui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dotfiles — Skills",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
