{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chunk Injector",
  "version": "0.1.0",
  "identifier": "com.ogutierrez.dotfiles.chunk-injector",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dotfiles — Chunk Injector",
        "width": 1140,
        "height": 760,
        "minWidth": 850,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
