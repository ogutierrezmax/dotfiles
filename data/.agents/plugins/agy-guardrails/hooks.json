{
  "test-file-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/guard-tests.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "model-prompt-adapter": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "bash ./scripts/model-prompt-adapter.sh",
        "timeout": 3
      }
    ]
  }
}
