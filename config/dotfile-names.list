# Nomes dos dotfiles a instalar (um por linha, relativos a data/).
# Cada nome vira um symlink em ~: sem ponto → ~/.nome; com ponto (ex.: .zsh) → ~/.zsh
# Linhas vazias e linhas que começam com # são ignoradas.


# Teste wrong_target: symlink em ~/.wronglink-test deve apontar para outro sítio (ex.: /etc/hostname).

gitconfig
.zshrc
.agents
.zsh

# Cursor
.config/Cursor/User/keybindings.json
.config/Cursor/User/settings.json

# KDE Plasma configs
kde-plasma/.config/kdeglobals
kde-plasma/.config/kwinrc
kde-plasma/.config/kwinrulesrc
kde-plasma/.config/kglobalshortcutsrc
kde-plasma/.config/plasmashellrc
kde-plasma/.config/plasma-org.kde.plasma.desktop-appletsrc
.tmux.conf

# Autostart
.config/autostart/obsidian.desktop
.config/autostart/plasma-panel-lang-color.desktop

# ai-jail — bubblewrap sandbox for AI coding agents
.local/bin/ai-jail
# opencode — wrapper que aplica ai-jail (--no-jail para bypass)
.local/bin/opencode

# opencode-pf — CLI de perfis isolados do OpenCode (scripts/opencode-pf.sh)
.local/bin/opencode-pf

# chunk-injector — injeção e monitoramento de trechos em arquivos não-symlinkáveis (scripts/chunk-injector.sh)
.local/bin/chunk-injector
.local/bin/chunk-injector-gui

# OpenCode — AI coding assistant CLI
.config/opencode/opencode.jsonc
.config/opencode/tui.json
.config/opencode/AGENTS.md
.config/opencode/rules/agents-symlink.mdc
.config/opencode/plugins/token-daily
# jail-status — indicador 🟢/🔴/⚪ do sandbox ai-jail + comando /jail
.config/opencode/plugins/jail-status
.local/share/applications/opencode-home.desktop
.local/share/applications/chunk-injector-gui.desktop
.local/share/opencode/auth.json.example

# PATH da sessão gráfica (systemd user environment.d) — cobre Dolphin e autostart
.config/environment.d/path.conf

# WezTerm — GPU-accelerated terminal emulator (replaces Konsole)
wezterm.lua

# Hermes Agent — OpenCode Orchestrated model provider plugin
.hermes/plugins/model-providers/opencode-orchestrated

# Antigravity CLI (agy) — agy-hud statusline configuration & plugin
.config/agy-hud/config.json
.gemini/config/plugins/agy-hud

# rclone — Google Drive montado em ~/GoogleDrive + backup diário do HD externo
.config/systemd/user/rclone-gdrive.service
.config/systemd/user/rclone-backup.service
.config/systemd/user/rclone-backup.timer

# chunk-injector — monitoramento periódico (a cada 5 min) de trechos injetados
.config/systemd/user/chunk-injector-monitor.service
.config/systemd/user/chunk-injector-monitor.timer
