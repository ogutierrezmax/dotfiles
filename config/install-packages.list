# --- GUI: pacotes .deb oficiais baixados ---------------------------------------------
deb:google-chrome-stable|https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
deb:code|https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64
deb:discord|https://discord.com/api/download/stable?platform=linux&format=deb

# --- Flatpak ------------------------------------------------------------------------
# Preencha com seus apps Flatpak (veja: flatpak list --app).
# flatpak:com.spotify.Client

# --- Snap ----------------------------------------------------------------------------
# Preencha com seus snaps (veja: snap list).
# snap:some-snap

# --- Homebrew ------------------------------------------------------------------------
# Requer o Homebrew instalado antes (veja entrada manual abaixo).
# brew:atuin

# --- npm global ----------------------------------------------------------------------
# npm:pnpm
# npm:typescript

# --- pipx -----------------------------------------------------------------------------
# pipx:some-tool

# --- Instaladores oficiais (EXECUTAM código de terceiros — confirmação individual) ------
script:https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh

# --- Manuais (apenas instruções, nada é executado) --------------------------------------
manual:Instalar oh-my-zsh (não use o instalador interativo — ele edita o .zshrc do repo e tenta chsh): git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git ~/.oh-my-zsh
manual:Instalar Cursor: baixe o .deb em https://www.cursor.com/downloads ou instale via flatpak
manual:Instalar Obsidian: baixe o .deb em https://obsidian.md/download ou via flatpak
manual:Instalar Brave: adicione o repo oficial (https://brave.com/linux) ou use o .deb do site
manual:Instalar Steam: sudo dpkg --add-architecture i386 && sudo apt update && sudo apt install steam (precisa de contrib/non-free)
manual:Instalar WezTerm: repo oficial https://wezterm.org/install-linux.html (ou cargo install)
manual:Instalar Docker: curl -fsSL https://get.docker.com | sh
manual:Instalar GitHub CLI: repo oficial https://github.com/cli/cli/blob/trunk/docs/install_linux.md
manual:Instalar Homebrew: /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
manual:Instalar TPM (tmux): git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
