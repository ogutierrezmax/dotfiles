# ============================================================================
# LISTA CURADA DE PROGRAMAS — config/install-packages.list
# ----------------------------------------------------------------------------
# Instalação de programas por gerenciador. Usada por scripts/install-packages.sh
# (comando "pkgs" no dotfiles-menu.sh).
#
# Formato (uma entrada por linha):  gerenciador:valor
#
#   apt:pacote       pacote do repositório Debian (via sudo apt)
#   deb:binario|URL  pacote .deb oficial baixado de URL e instalado via apt (resolve deps)
#   flatpak:appid    app Flatpak do Flathub
#   snap:snap        pacote Snap
#   brew:formula     fórmula Homebrew (requer brew instalado antes)
#   npm:pacote       pacote global npm (via npm install -g)
#   pipx:pacote      pacote Python via pipx
#   script:URL       instalador oficial (baixa e EXECUTA código de terceiros)
#   manual:texto     apenas instruções (nunca executa nada)
#
# Regras:
#   - Linhas em branco e linhas que começam com # são ignoradas.
#   - Comentários após "#" no fim da linha são ignorados.
#   - O script detecta o que já está instalado e pula.
#   - Entradas "manual:" são apenas mostradas (nunca executadas).
#   - Entradas "script:" exigem confirmação individual (executam código externo).
# ============================================================================

# --- Core / terminal ----------------------------------------------------------
apt:git
apt:tmux
apt:zsh
apt:curl
apt:wget
apt:ca-certificates
apt:file
apt:tree
apt:htop
apt:ripgrep
apt:fd-find
apt:fzf
apt:eza
apt:bat
apt:zoxide
apt:jq
apt:unzip
apt:zip
apt:less
apt:xdg-utils

